<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CaseChampGui.ViewModels"
             mc:Ignorable="d"
             x:Class="CaseChampGui.Views.Text2SqlView"
             x:DataType="vm:Text2SqlViewModel">

    <Grid Margin="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ContentMargin, FallbackValue='28,20,28,24'}"
          RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Spacing="6" Margin="2,0,2,16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding HintTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" />
                <Border Classes="pill" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="preview" Classes="muted" FontSize="11" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding HintSubtitle}"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Classes="editor-card">
            <Grid RowDefinitions="*,Auto">
                <TextBox Grid.Row="0"
                         Classes="editor flat"
                         Text="{Binding InputText, Mode=TwoWay}"
                         IsEnabled="{Binding IsEnabled}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Padding="20,18,20,8"
                         PlaceholderText="Опишите запрос на русском языке. Например: покажи всех пользователей старше 25 лет." />

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="◌"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="AI-переводчик пока отключён — раздел появится в одном из следующих обновлений."
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
