<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CaseChampGui.ViewModels"
             xmlns:views="using:CaseChampGui.Views"
             mc:Ignorable="d"
             x:Class="CaseChampGui.Views.SqlView"
             x:DataType="vm:SqlViewModel">

    <Grid ColumnDefinitions="*,280"
          Margin="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ContentMargin, FallbackValue='28,20,28,24'}">

        <Grid Grid.Column="0" Margin="0,0,20,0">

            
            <Grid IsVisible="{Binding IsClassicMode}" RowDefinitions="Auto,*">

                
                <Border Grid.Row="0"
                        Classes="editor-card"
                        Margin="0,0,0,18">
                    <Grid RowDefinitions="*,Auto">
                        <TextBox Grid.Row="0"
                                 x:Name="EditorTextBox"
                                 Classes="editor flat"
                                 Text="{Binding SqlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditorFontSize, FallbackValue=14}"
                                 MinHeight="120"
                                 Padding="18,16,18,8"
                                 PlaceholderText="SELECT * FROM users;" />

                        <WrapPanel x:Name="EditorToolbar"
                                  Grid.Row="1"
                                  Margin="14,4,14,12"
                                  Orientation="Horizontal"
                                  VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Padding="10,5"
                                        Margin="0,0,8,6"
                                        IsEnabled="{Binding HasHistory}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🕘" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="История" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <Border Padding="6" MinWidth="360" MaxWidth="520" MaxHeight="380">
                                                <DockPanel LastChildFill="True">
                                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,4,6,8">
                                                        <TextBlock Text="История запросов" FontWeight="SemiBold" FontSize="13" />
                                                        <Button Grid.Column="1"
                                                                Classes="ghost"
                                                                Content="Очистить"
                                                                FontSize="11"
                                                                Padding="8,4"
                                                                Command="{Binding ClearHistoryCommand}" />
                                                    </Grid>
                                                    <ScrollViewer>
                                                        <ItemsControl ItemsSource="{Binding History}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="vm:QueryHistoryItem">
                                                                    <Button Classes="ghost"
                                                                            HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Padding="10,8"
                                                                            Margin="0,2"
                                                                            Click="OnHistoryItemClick">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                                            <TextBlock Grid.Row="0"
                                                                                       Grid.Column="0"
                                                                                       Text="{Binding StatusGlyph}"
                                                                                       Margin="0,0,8,0"
                                                                                       VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Row="0"
                                                                                       Grid.Column="1"
                                                                                       Text="{Binding Preview}"
                                                                                       Classes="mono"
                                                                                       FontSize="12"
                                                                                       TextWrapping="NoWrap"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Row="0"
                                                                                       Grid.Column="2"
                                                                                       Text="{Binding TimestampText}"
                                                                                       Classes="muted"
                                                                                       FontSize="10"
                                                                                       Margin="10,0,0,0"
                                                                                       VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Row="1"
                                                                                       Grid.Column="1"
                                                                                       Grid.ColumnSpan="2"
                                                                                       Text="{Binding Summary}"
                                                                                       Classes="muted"
                                                                                       FontSize="11"
                                                                                       Margin="0,2,0,0" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="ghost"
                                        Content="✕ Очистить"
                                        FontSize="12"
                                        Padding="10,5"
                                        Margin="0,0,8,6"
                                        Command="{Binding ClearCommand}" />
                                <ProgressBar IsIndeterminate="True"
                                             IsVisible="{Binding IsBusy}"
                                             Width="80"
                                             Height="3"
                                             Margin="0,0,8,6"
                                             Foreground="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                <TextBlock x:Name="CtrlEnterHint"
                                           Text="ctrl+enter"
                                           FontSize="11"
                                           Margin="0,0,8,6"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Classes="accent compact-action"
                                        Content="▶ Выполнить"
                                        Margin="0,0,8,6"
                                        Command="{Binding ExecuteCommand}" />
                                <Button Classes="compact-action"
                                        Content="Dry run"
                                        Margin="0,0,0,6"
                                        Command="{Binding DryRunCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Результат"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    
                    <Border Grid.Row="1"
                            IsVisible="{Binding HasMessage}"
                            Margin="0,0,0,10"
                            Padding="12,10"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource SurfaceMutedBrush}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,12,2"
                                    Background="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ResultMessage}"
                                       Classes="mono"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Panel Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,40">
                            <StackPanel.IsVisible>
                                <Binding Path="HasResults" Converter="{x:Static views:NegateBoolConverter.Instance}" />
                            </StackPanel.IsVisible>
                            <TextBlock Text="◌" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="Здесь появятся строки SELECT-запроса"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border IsVisible="{Binding HasResults}"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Background="{DynamicResource SurfaceBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="ResultsGrid" MinWidth="100" />
                            </ScrollViewer>
                        </Border>
                    </Panel>
                </Grid>
            </Grid>

            
            <Grid IsVisible="{Binding IsChatMode}" RowDefinitions="*,Auto">

                <ScrollViewer Grid.Row="0" x:Name="ChatScroll" Padding="0,0,4,12">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,60,0,40">
                            <StackPanel.IsVisible>
                                <Binding Path="HasMessages" Converter="{x:Static views:NegateBoolConverter.Instance}" />
                            </StackPanel.IsVisible>
                            <TextBlock Text="💬" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="Диалог пуст. Напишите SQL-запрос ниже."
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ChatMessageViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,18">
                                        <Border Classes="bubble-user">
                                            <TextBlock Text="{Binding Query}"
                                                       Classes="mono"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Border>

                                        <Border Classes="bubble-ai">
                                            <StackPanel Spacing="8">
                                                <ProgressBar IsIndeterminate="True"
                                                             Height="3"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             IsVisible="{Binding IsBusy}" />
                                                <TextBlock Text="{Binding DisplayMessage}"
                                                           IsVisible="{Binding HasMessage}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <views:ResultTable Result="{Binding Result}"
                                                                   IsVisible="{Binding HasRows}"
                                                                   MaxHeight="320" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding TimestampText}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                
                <Border Grid.Row="1" Classes="editor-card" Margin="0,4,0,0">
                    <Grid RowDefinitions="*,Auto">
                        <TextBox Grid.Row="0"
                                 x:Name="ChatInputBox"
                                 Classes="editor flat"
                                 Text="{Binding SqlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditorFontSize, FallbackValue=13}"
                                 MinHeight="56"
                                 MaxHeight="180"
                                 Padding="16,14,16,6"
                                 PlaceholderText="Напишите SQL-запрос. Ctrl+Enter — отправить." />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,2,12,10">
                            <Button Grid.Column="0"
                                    Classes="ghost"
                                    Content="✕ Очистить чат"
                                    FontSize="12"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ClearChatCommand}" />
                            <Button Grid.Column="1"
                                    Classes="accent compact-action"
                                    Content="▶ Отправить"
                                    Command="{Binding ExecuteCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <views:SchemaPaneView Grid.Column="1" DataContext="{Binding Schema}" />
    </Grid>
</UserControl>
